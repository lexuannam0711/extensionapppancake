# Desktop update client
UPDATE_MANIFEST_URL=
UPDATE_PUBLIC_KEY=
UPDATE_ALLOWED_HOSTS=github.com,objects.githubusercontent.com

# Development-only data override; production Electron sets stable appData paths
PANCAKE_DATA_DIR=
PANCAKE_UPLOADS_DIR=
